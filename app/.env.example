# Supabase — create a new project at supabase.com/dashboard/projects
# Settings → Data API → URL + anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe — Phase 3 (not used until billing is wired)
# Dashboard → Developers → API keys → Publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry (browser-side error reporting). Optional locally; recommended in
# production. Create a React project at sentry.io → copy DSN. No-op if blank.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
