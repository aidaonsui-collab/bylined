# Search provider: DuckDuckGo HTML scraping (no key required by default).
# To swap to a paid SERP API later, replace src/clients/ddg.ts with the
# new client and update the import in src/orchestrator.ts.

# Minimax 2.7
# International endpoint: https://api.minimaxi.chat/v1
# China endpoint: https://api.minimax.chat/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Webflow publishing (only needed if using `npm run webflow`)
# Generate at: Webflow Site Settings → Apps & integrations → API access
# → Generate API token. Permissions: CMS read+write, Sites read+publish.
WEBFLOW_API_TOKEN=

# WordPress publishing (only needed if using `npm run publish`)
# Create an Application Password: WP Admin → Users → Profile →
# Application Passwords → enter "Bylined" → "Add New". Copy the 24-char
# string (with spaces) and paste below.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Supabase — required by `npm run worker` (Phase 4 article-generation
# worker that polls the jobs table) and optionally used by the cost
# tracker to mirror events into public.cost_events.
# Service role key: Supabase dashboard → Project Settings → API →
# Project API keys → service_role. KEEP THIS SECRET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker tuning
WORKER_POLL_MS=5000

# Sentry — error reporting for the worker. Optional locally; strongly
# recommended in production (the worker runs unattended and we'd
# otherwise find out about crashes by noticing articles stop).
# Create a Node project at sentry.io → Settings → Client Keys.
SENTRY_DSN=
SENTRY_ENV=production

# Optional
LOG_LEVEL=info
